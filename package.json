{
  "name": "joculdetectivului",
  "version": "1.0.0",
  "type": "module",
  "description": "Folder-game ecommerce & gameplay",
  "author": "Daniel Anca & Mubbasher Yasin",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:server": "concurrently \"tsx server.ts\" \"sh -c 'until curl -s http://127.0.0.1:1994/health >/dev/null; do sleep 1; done; open http://localhost:1994/admin'\"",
    "dev:client": "vite --config vite.config.ts",
    "clean": "rimraf dist",
    "build": "npm install && npm run clean && tsc -p tsconfig.json && npm run build:client && npm run build:server && npm run copy-files && node fix-extensions.js",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --ssr src/client/entry-server.tsx --outDir dist/server",
    "copy-files": "copyfiles \"public/**/*\" dist && copyfiles -u 2 \"data/blog/**/*.md\" dist && copyfiles -u 2 \"dist/client/**/*\" dist && copyfiles -u 2 \"dist/client/assets/**/*\" dist/public",
    "deploy": "npm run killport && npm install --production && npm run build && npm run serve:pm2",
    "deploy:quick": "npm run killport && npm run build && npm run pm2:restart",
    "redeploy": "npm run killport && npm run build && pm2 stop ancavisuals && pm2 start ancavisuals",
    "deploy:no-build": "npm run killport && npm install --production && npm run pm2:restart",
    "start": "npm run serve:pm2",
    "serve": "npm run serve:pm2",
    "serve:pm2": "pm2-runtime start ecosystem.config.cjs",
    "pm2:start": "npm run killport && pm2 start ecosystem.config.cjs --name ancavisuals",
    "pm2:restart": "npm run killport && pm2 restart ancavisuals",
    "pm2:reload": "npm run killport && pm2 reload ancavisuals",
    "pm2:stop": "pm2 stop ancavisuals",
    "pm2:delete": "pm2 delete ancavisuals",
    "pm2:logs": "pm2 logs ancavisuals",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "killport": "fuser -k 1994/tcp || true",
    "killport:force": "lsof -ti:1994 | xargs kill -9 || true",
    "test": "vitest run",
    "test:all": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report reports/playwright",
    "coverage:open": "open reports/coverage/index.html",
    "typecheck": "tsc --noEmit",
    "seed:wedding-seating": "tsx scripts/seedWeddingSeating.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "env:check": "node -e \"console.log('PORT:', process.env.PORT || 'not set'); console.log('NODE_ENV:', process.env.NODE_ENV || 'not set'); console.log('B64 len:', (process.env.FIREBASE_SERVICE_ACCOUNT_BASE64||'').length)\"",
    "env:sa": "node -e \"const s=process.env.FIREBASE_SERVICE_ACCOUNT_BASE64||''; if(!s){console.log('no B64');process.exit(1)} const sa=JSON.parse(Buffer.from(s,'base64').toString('utf8')); console.log(sa.project_id, sa.client_email)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@loadable/component": "^5.16.3",
    "@types/heic-convert": "^2.1.0",
    "@types/marked": "^5.0.2",
    "@types/serve-static": "^1.15.4",
    "aos": "^2.3.4",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.16",
    "compression": "1.7.4",
    "dotenv": "^17.2.1",
    "express": "4.18.2",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.7.0",
    "font-awesome": "^4.7.0",
    "framer-motion": "^12.18.1",
    "gray-matter": "^4.0.3",
    "heic-convert": "^2.1.0",
    "jsonrepair": "^3.14.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "plyr": "^3.7.8",
    "puppeteer": "^24.40.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.70.0",
    "react-router-dom": "^6.21.3",
    "react-type-animation": "^3.2.0",
    "react-window": "^1.8.10",
    "serve-static": "^1.15.0",
    "sharp": "^0.34.5",
    "swiper": "^12.0.2",
    "tailwindcss": "3.3.5",
    "tsx": "^3.14.0",
    "uuid": "^9.0.1",
    "yet-another-react-lightbox": "^3.23.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/archiver": "^7.0.0",
    "@types/compression": "1.7.4",
    "@types/express": "^4.17.20",
    "@types/google.maps": "^3.58.1",
    "@types/loadable__component": "^5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^18.2.34",
    "@types/react-dom": "^18.2.14",
    "@types/react-window": "^1.8.8",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^9",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^0.34.6",
    "concurrently": "8.2.2",
    "copyfiles": "^2.4.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-react-parser": "^5.2.11",
    "include-media": "^2.0.0",
    "jsdom": "^22.1.0",
    "node-fetch": "^3.3.2",
    "pm2": "^6.0.14",
    "postcss": "8.4.31",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "sass": "^1.69.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^4.5.2",
    "vitest": "^0.34.6"
  },
  "packageManager": "npm",
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid"
  }
}
