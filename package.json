{
  "name": "joculdetectivului",
  "version": "1.0.0",
  "type": "module",
  "description": "Folder-game ecommerce & gameplay",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonluca/vite-typescript-ssr-react"
  },
  "author": "Daniel Anca & Mubbasher Yasin",
  "license": "MIT",
  "scripts": {
    "dev:server": "tsx server.ts",
    "dev:client": "npm run build:client && vite --config vite.config.ts dev",
    "killport": "fuser -k 1994/tcp",
    "build": "rimraf dist && tsc -p tsconfig.json && npm run build:client && npm run build:server && npm run copy-files && node fix-extensions.js",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --ssr src/client/entry-server.tsx --outDir dist/server",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "serve": "cross-env NODE_ENV=production node ./dist/server",
    "serve:local": "vite serve",
    "env:check": "node -e \"console.log('B64 len =',(process.env.FIREBASE_SERVICE_ACCOUNT_BASE64||'').length);console.log('PATH =',process.env.FIREBASE_SERVICE_ACCOUNT_PATH||null);console.log('PORT =',process.env.PORT||null)\"",
    "env:sa": "node -e \"const s=process.env.FIREBASE_SERVICE_ACCOUNT_BASE64||''; if(!s){console.log('no B64');process.exit(1)} const sa=JSON.parse(Buffer.from(s,'base64').toString('utf8')); console.log(sa.project_id, sa.client_email)\"",
    "clean": "rimraf dist/",
    "copy-files": "copyfiles \"public/**/*\" dist && copyfiles -u 2 \"dist/client/**/*\" dist && copyfiles -u 2 \"dist/client/assets/**/*\" dist/public",
    "format": "prettier --write src types"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@google-cloud/firestore": "^7.3.0",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@loadable/component": "^5.16.3",
    "@types/serve-static": "^1.15.4",
    "aos": "^2.3.4",
    "autoprefixer": "^10.4.16",
    "compression": "1.7.4",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "express": "4.18.2",
    "firebase": "^12.2.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.4.0",
    "font-awesome": "^4.7.0",
    "framer-motion": "^12.18.1",
    "fs": "^0.0.1-security",
    "nodemailer": "^7.0.6",
    "plyr": "^3.7.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.21.3",
    "react-type-animation": "^3.2.0",
    "serve-static": "^1.15.0",
    "tailwindcss": "3.3.5",
    "tsx": "^3.14.0",
    "uuid": "^9.0.1",
    "yet-another-react-lightbox": "^3.23.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/compression": "1.7.4",
    "@types/concurrently": "6.4.0",
    "@types/eslint": "8.44.6",
    "@types/express": "^4.17.20",
    "@types/google.maps": "^3.58.1",
    "@types/loadable__component": "^5",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^18.2.34",
    "@types/react-dom": "^18.2.14",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^9",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^0.34.6",
    "concurrently": "8.2.2",
    "copyfiles": "^2.4.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-react-parser": "^5.0.11",
    "include-media": "^2.0.0",
    "jsdom": "^22.1.0",
    "postcss": "8.4.31",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "sass": "^1.69.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^4.5.2",
    "vitest": "^0.34.6"
  },
  "packageManager": "yarn@4.0.1",
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid"
  }
}
