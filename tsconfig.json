{
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "alwaysStrict": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2018",
    "types": ["vite/client", "google.maps"],
  },
  "include": ["src/**/*", "server.ts", "node_modules/vite/types/*"],
  "exclude": ["tests/**/*", "playwright.config.ts"],
}
